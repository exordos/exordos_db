        padding_left: 0
        position: 3
        direction: row
        gap: 0
        justify_content: flex-start
        align_items: stretch
        parent_uuid: $exordos_ecosystem.ui.components.$pg_page:uuid
        css: ""
        conditional_visibility:
          kind: always
        data_source_uuid: $exordos_ecosystem.ui.components.$pg_instances_source:uuid
        columns:
          - path: "name"
            header: "Название"
          - path: "status"
            header: "Статус"
            format: status
          - path: "ipsv4"
            header: "IPv4"
          - path: "cpu"
            header: "CPU"
          - path: "ram"
            header: "RAM, МБ"
          - path: "disk_size"
            header: "Диск, ГБ"
          - path: "nodes_number"
            header: "Ноды"
          - path: "created_at"
            header: "Создан"
        background_color: ""
        border_color: "var(--ui-border)"
        border_width: 1
        border_radius: 8
        page_size: 20
        grid_lines: both
        row_actions:
          - kind: open_window
            label: "Открыть"
            window_uuid: $exordos_ecosystem.ui.components.$pg_instance_window:uuid
            method: GET
            url: "/api/dbaas/v1/types/postgres/instances/{uuid}"
          - kind: request
            label: "Удалить"
            method: DELETE
            url: "/api/dbaas/v1/types/postgres/instances/{uuid}"
            confirm: "Удалить инстанс «{name}» вместе с его базами данных?"
          - kind: copy
            label: "Коп. UUID"
            path: "uuid"
        translations:
          - locale: en
            field: columns.0.header
            value: "Name"
          - locale: en
            field: columns.1.header
            value: "Status"
          - locale: en
            field: columns.4.header
            value: "RAM, MB"
          - locale: en
            field: columns.5.header
            value: "Disk, GB"
          - locale: en
            field: columns.6.header
            value: "Nodes"
          - locale: en
            field: columns.7.header
            value: "Created"
          - locale: en
            field: row_actions.0.label
            value: "Open"
          - locale: en
            field: row_actions.1.label
            value: "Delete"
          - locale: en
            field: row_actions.1.confirm
