        parent_uuid: $exordos_ecosystem.ui.components.$pg_page:uuid
        url: "/api/dbaas/v1/types/postgres/versions/"
        method: GET
        refresh_method:
          kind: once
        conditional_visibility:
          kind: always
        translations: []

    # An instance is several nodes, so its addresses are a list and
    # the cell writes it out whole. The table reloads its own source
    # once a delete is answered, so the row leaves the list on its own.
    pg_instances_table:
      project_id: $dbaas_ui.imports.$eco_project:uuid
      props:
        kind: table
        name: "pg-instances-table"
        description: ""
