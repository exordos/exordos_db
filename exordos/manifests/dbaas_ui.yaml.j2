# DBaaS page manifest for exordos_ecosystem.
#
# Builds a "Базы данных" entry in the left menu of the ecosystem account and
# the page behind it: the PostgreSQL instances of the project as a table, a
# search over them, an instance opened in place of the table with its size
# edited where it is read, its users and its databases listed and created
# beside it, and a create form in a modal window.
#
# The page talks to the DBaaS user API through the core load balancer
# (`/api/dbaas/`, see dbaas.yaml.j2). Inside a realm session the requests go to
# that realm, so the page lists the instances of the installation the visitor
# is working in. The element therefore doesn't require dbaas itself: the
# ecosystem it is installed next to may run without it.
#
# It is built by `make build` beside the dbaas element and installed from the
# build output:
#   exordos em elements install \
#     output/exordos-elements/dbaas_ui/<version>/manifests/dbaas_ui.yaml
#
# The conventions of the ecosystem's own pages
# (exordos_ecosystem/exordos/manifests/ecosystem_ui_nodes.yaml.j2) hold here:
# every `props` block spells out ALL fields of its kind (the agent hashes the
# whole value it reads back), the tree is built with `parent_uuid`, siblings
# are ordered by `position`, and the page is filed under the ecosystem's own
# project — the administration project, so it is read by every account.
# Pinned uuids start with `db5a` to stay apart from the ecosystem's pages.

name: "dbaas_ui"
description: "DBaaS page built with the ecosystem UI constructor"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  exordos_ecosystem:
    from_version: "0.0.0"
  core:
    from_version: "0.0.0"

imports:
  eco_project:
    element: "$exordos_ecosystem"
    kind: "resource"
    link: "$core.iam.projects.$eco_project"

resources:
