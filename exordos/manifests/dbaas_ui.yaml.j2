        padding_right: 20
        padding_bottom: 20
        padding_left: 20
        position: 0
        direction: column
        gap: 16
        justify_content: flex-start
        align_items: stretch
        parent_uuid: null
        css: ""
        conditional_visibility:
          kind: always
        background_color: "var(--ui-page-bg)"
        border_color: "var(--ui-border)"
        border_width: 1
        border_radius: 12
        action:
          kind: dummy
        translations: []

