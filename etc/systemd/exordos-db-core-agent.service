[Unit]
Description=Exordos Core Agent Service
After=network-online.target

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5
ExecStart=exordos-universal-agent-db-back --config-dir /etc/exordos_db/exordos_db.d --config-file /etc/exordos_db/core_agent.conf

[Install]
WantedBy=multi-user.target
