[Unit]
Description=Exordos PostgreSQL exporter (Prometheus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Peer authentication over the local socket, no password to deliver
User=postgres
Group=postgres
Environment="DATA_SOURCE_NAME=host=/var/run/postgresql user=postgres dbname=postgres sslmode=disable"
# Instance-wide statistics. The per-table ones and the vacuum progress name
# tables of the database of the session only,
# exordos-postgres-exporter-databases collects them per database.
ExecStart=/usr/bin/prometheus-postgres-exporter \
    --web.listen-address=127.0.0.1:9187 \
    --collector.database_wraparound \
    --collector.long_running_transactions \
    --collector.stat_checkpointer \
    --no-collector.stat_progress_vacuum \
    --no-collector.stat_user_tables \
    --no-collector.statio_user_tables
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
