[db]
connection_url = postgresql://{{ GC_PG_USER }}:{{ GC_PG_PASS }}@localhost:5432/{{ GC_PG_DB }}
connection_pool_max_size = 4

[agent]
uuid5_name = core_agent
payload_path = /var/lib/exordos/exordos_db/core_agent/payload.json
target_fields_path = /var/lib/exordos/exordos_db/core_agent/target_fields.json
orch_client = http
orch_endpoint = http://core.local.genesis-core.tech:11011
status_endpoint = http://core.local.genesis-core.tech:11012

[models]
em_dbaas_types_postgres_versions = exordos_db.user_api.dm.models:PGVersion
em_dbaas_types_postgres_instances = exordos_db.infra.dm.models:PGInstance
em_dbaas_types_postgres_instances_users = exordos_db.user_api.dm.models:PGUser
em_dbaas_types_postgres_instances_databases = exordos_db.user_api.dm.models:PGDatabase
em_dbaas_types_postgres_instances_backup_policies = exordos_db.user_api.dm.models:PGBackupPolicy

